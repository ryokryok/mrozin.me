---
import type { SNSListType } from "../lib/schema";
import GitHubLogo from "./GitHubLogo.astro";
import XLogo from "./XLogo.astro";
import ZennLogo from "./ZennLogo.astro";
import HatenaLogo from "./HatenaLogo.astro";
import Instagram from "./Instagram.astro";

interface Props {
  links: SNSListType[];
}

const { links } = Astro.props;
---

<div class="links">
  <ul class="link-list">
    {
      links.map((link) => (
        <li class="link-item">
          <a
            href={link.url}
            title={link.name}
            target="_blank"
            rel="noopener noreferrer"
          >
            {link.name === "GitHub" ? (
              <GitHubLogo width="2.5rem" height="2.5rem" />
            ) : link.name === "Twitter" || link.name === "X" ? (
              <XLogo width="2.5rem" height="2.5rem" />
            ) : link.name === "Zenn" ? (
              <ZennLogo width="2.5rem" height="2.5rem" />
            ) : link.name === "Hatena" ? (
              <HatenaLogo width="2.5rem" height="2.5rem" />
            ) : link.name === "Instagram" ? (
              <Instagram width="2.5rem" height="2.5rem" />
            ) : (
              <p>{link.name}</p>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .links {
    display: flex;
  }

  .link-list {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
  }

  .link-item {
    color: var(--ink);
  }

  .link-item a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    font-size: 2.5rem;
    background: #ffffff;
    border: var(--border);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }

  .link-item a:hover,
  .link-item a:focus-visible {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--ink);
    outline: none;
  }

  .link-item a:active {
    transform: translate(4px, 4px);
    box-shadow: 0 0 0 var(--ink);
  }

  @media screen and (max-width: 30rem) {
    .links {
      justify-content: center;
    }
  }
</style>
