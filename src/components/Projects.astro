---
import type { ProjectListType } from "../lib/schema";
import ExternalLinkIcon from "./ExternalLinkIcon.astro";

interface Props {
  projects: ProjectListType[];
}

const { projects } = Astro.props;
---

<div class="content-root">
  <h2 class="content-title">Projects</h2>
  <div class="project-list">
    {
      projects.map((project) => (
        <article class="project-card">
          <div class="project-header">
            <h3 class="project-title">{project.title}</h3>
            <a
              href={project.url}
              title={project.title}
              target="_blank"
              rel="noopener noreferrer"
              class="project-link"
              aria-label={`${project.title} を開く`}
            >
              <ExternalLinkIcon />
            </a>
          </div>
          <p class="project-description">{project.description}</p>
        </article>
      ))
    }
  </div>
</div>

<style>
  .content-root {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .content-title {
    font-size: 2rem;
    font-weight: 900;
    color: var(--ink);
    background: #ffffff;
    border: var(--border);
    padding: 0.35rem 0.9rem;
    align-self: flex-start;
    letter-spacing: 0.02em;
    box-shadow: var(--shadow-sm);
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .project-card {
    background: #ffffff;
    border: var(--border);
    box-shadow: var(--shadow);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .project-header {
    display: flex;
    flex-direction: row;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: var(--border);
    padding-bottom: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .project-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--ink);
    background: #ffffff;
    border: var(--border);
    box-shadow: 3px 3px 0 var(--ink);
    flex-shrink: 0;
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }

  .project-link:hover,
  .project-link:focus-visible {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--ink);
    outline: none;
  }

  .project-link:active {
    transform: translate(3px, 3px);
    box-shadow: 0 0 0 var(--ink);
  }

  .project-description {
    font-size: 1rem;
    font-weight: 500;
    color: var(--muted);
    line-height: 1.6;
    white-space: pre-line;
  }

  @media screen and (max-width: 30rem) {
    .project-card {
      padding: 1rem 1.1rem;
    }
    .project-title {
      font-size: 1.25rem;
    }
  }
</style>
