---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content="Profile site about Mr_ozin" />
    <meta property="og:title" content="Mr_ozin" />
    <meta property="og:description" content="Profile site about Mr_ozin" />
    <meta property="og:url" content="https://mrozin.me/" />
    <meta property="og:image" content="https://mrozin.me/author.jpg" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@Mr_ozin" />
    <meta name="twitter:creator" content="@Mr_ozin" />
  </head>
  <body>
    <slot />
  </body>
</html>
