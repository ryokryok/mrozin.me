---
import Layout from "../layouts/Layout.astro";
import Avatar from "../components/Avatar.astro";
import Links from "../components/Links.astro";
import Projects from "../components/Projects.astro";
import { fetchProfile } from "../lib/server/fetchProfile";

const profile = await fetchProfile();
---

<Layout title="Mr_ozin">
  <div class="content-container">
    <Avatar
      name={profile.name}
      username={profile.username}
      description={profile.description}
      avatar={profile.avatar}
    />

    <Links links={profile.sns} />

    <Projects projects={profile.projects} />
  </div>
</Layout>

<style is:global>
  :root {
    --ink: #111111;
    --paper: #f5f2ea;
    --muted: #555555;
    --shadow: 6px 6px 0 var(--ink);
    --shadow-sm: 4px 4px 0 var(--ink);
    --border: 3px solid var(--ink);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: sans-serif;
  }

  html {
    box-sizing: border-box;
    font-size: 16px;
    margin: 0;
    padding: 0;
  }

  body {
    background-color: var(--paper);
    color: var(--ink);
    font-size: 1rem;
    min-height: 100vh;
  }

  body,
  h1,
  h2,
  h3,
  h4,
  h5,
  h6,
  p,
  ol,
  ul {
    font-weight: normal;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      "sans-serif";
  }

  ol,
  ul {
    list-style: none;
  }

  a,
  a:visited,
  a:hover,
  a:active {
    text-decoration: none;
    color: inherit;
  }

  a:visited {
    text-decoration: none;
  }

  img {
    max-width: 100%;
    height: auto;
  }
</style>

<style>
  .content-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 40rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
  @media screen and (max-width: 30rem) {
    .content-container {
      padding: 1.5rem 1rem;
      gap: 1.5rem;
    }
  }
</style>
